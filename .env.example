# -------------------------------------------------------------
# CommitFlow Backend Environment Configuration
# -------------------------------------------------------------

# Neon PostgreSQL Connection URL (SSL is enabled by default for Neon)
# Format: postgresql://<user>:<password>@<ep-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Supported Gemini Model (e.g., gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-3.1-flash-lite

# Backend Server Port (defaults to 5000)
PORT=5000

# Optional Initial Administrator Bootstrap Credentials (or run: python server/manage.py create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

