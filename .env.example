# -------------------------------------------------------------
# CommitFlow Backend Environment Configuration
# -------------------------------------------------------------

# Neon PostgreSQL Connection URL (SSL is enabled by default for Neon)
# Format: postgresql://<user>:<password>@<ep-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Supported Gemini Model (e.g., gemini-3.5-flash-lite, gemini-3.5-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend Server Port (defaults to 5000)
PORT=5000

# Optional Initial Administrator Bootstrap Credentials (or run: python server/manage.py create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# LiveKit Cloud Real-Time Meetings Configuration
LIVEKIT_URL=wss://YOUR_LIVEKIT_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_ROTATED_LIVEKIT_API_SECRET

# Trello Integration Configuration (https://trello.com/app-key)
TRELLO_API_KEY=YOUR_TRELLO_API_KEY
TRELLO_API_SECRET=YOUR_TRELLO_API_SECRET
TRELLO_TOKEN=YOUR_TRELLO_MEMBER_TOKEN
TRELLO_BOARD_ID=YOUR_TRELLO_BOARD_ID



